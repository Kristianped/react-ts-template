{
  "name": "react-ts-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "sass:watch": "node scripts/sass_compile.ts --watch",
    "sass:build": "node scripts/sass_compile.ts",
    "tsc:watch": "tsc --watch",
    "tsc:build": "tsc --build",
    "vite:watch": "vite",
    "vite:build": "vite build",
    "dev": "npm-run-all --parallel *:watch",
    "build": "npm-run-all --serial *:build",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@react-icons/bootstrap-icons": "^6.0.0-beta.0",
    "@react-icons/fontawesome5": "^6.0.0-beta.0",
    "@reduxjs/toolkit": "^2.13.0",
    "bootstrap": "^6.0.0-alpha.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss-load-config": "^6.0.1",
    "postcss-nested": "^9.0.0",
    "sass-embedded": "^1.105.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">= 26",
    "pnpm": ">=12"
  }
}
