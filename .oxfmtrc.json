{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "printWidth": 100,
  "insertFinalNewline": true,
  "trailingComma": "es5",
  "sortImports": true,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["**/*.json", "**/*.json5"],
      "options": {
        "singleQuote": false,
        "quoteProps": "preserve"
      }
    },
    {
      "files": ["**/*.yaml", "**/*.yml"],
      "options": {
        "singleQuote": false
      }
    }
  ],
  "ignorePatterns": ["dist/", "LICENSE.md", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
}
